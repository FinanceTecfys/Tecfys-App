# Environment of the Tecfys app. Copy to .env.local for local development; on
# Vercel set the same names per environment (Production / Preview).
#
# EVERY variable is SERVER-ONLY. The app has no NEXT_PUBLIC_ variable: the
# browser never talks to Supabase or any API directly, so nothing here may ever
# be renamed with a NEXT_PUBLIC_ prefix (Next.js would inline it into the client
# bundle). Validated at server start by src/lib/env.ts: a missing or invalid
# required variable stops the server with an error naming it.
# Listed keys must match src/lib/env.ts (guarded by src/lib/__tests__/env.test.ts).

# --- Required ---------------------------------------------------------------

# [server-only, required] Supabase API URL. Local: printed by `supabase status`
# (http://127.0.0.1:55421). Cloud: https://<project-ref>.supabase.co
SUPABASE_URL=
# [server-only, required, SECRET] Supabase secret key (service role): the data
# layer, storage and user admin. Bypasses RLS - never expose it.
SUPABASE_SECRET_KEY=
# [server-only, required] Supabase publishable key: Supabase Auth login sessions
# only (password grant, cookie refresh). It reaches no table (RLS + no grants).
SUPABASE_PUBLISHABLE_KEY=
# [server-only, required] Public origin of THIS deployment, no trailing slash.
# Invitation / password emails link to it. https except localhost.
#   production https://app.tecfys.com | staging https://staging.tecfys.com
#   local      http://127.0.0.1:3000
SITE_URL=

# --- Optional integrations (leave empty to disable) -------------------------

# [server-only, optional] Signaturit (e-signature) - not wired yet.
SIGNATURIT_API_URL=
# [server-only, optional, SECRET] Signaturit API token.
SIGNATURIT_TOKEN=

# [server-only, optional, SECRET] Holded (ERP) API v2 key: Holded -> Ajustes ->
# API -> "Generar nueva clave". Read by the ERP sync (/erp and
# `npm run sync:holded`), sent as "Authorization: Bearer <key>". Needs the
# sales:invoices.read permission. Empty: only the Excel import works.
HOLDED_API_KEY=

# Informa D&B API v2 ("Buscar en Informa por CIF" in Nuevo scoring). Never stored
# in the DB. The app logs in by itself (POST /login, password in headers only),
# keeps the session in server memory and renews it on 10005 (session expired).
# Settings -> Informa -> "Probar conexion" checks it with the demo CIF A00000000.
# [server-only, optional] https://services.informa.es/api/v2 - must be https on *.informa.es.
INFORMA_API_URL=
# [server-only, optional, SECRET] Informa portal username.
INFORMA_USERNAME=
# [server-only, optional, SECRET] Informa portal password.
INFORMA_PASSWORD=
# [server-only, optional, SECRET] A session to try first; normally empty.
INFORMA_SESSION=
