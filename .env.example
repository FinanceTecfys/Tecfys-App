# Local Supabase (values printed by `supabase start` / `supabase status`)
SUPABASE_URL=http://127.0.0.1:55421
# Server-only secret key. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Publishable key (PUBLISHABLE_KEY in `supabase status`): Supabase Auth login
# sessions only. The data layer keeps using the secret key above.
SUPABASE_PUBLISHABLE_KEY=

# Signaturit (e-signature) - not wired yet
SIGNATURIT_API_URL=https://api.sandbox.signaturit.com
SIGNATURIT_TOKEN=

# Holded (ERP) API v2 key: Holded -> Ajustes -> API -> "Generar nueva clave".
# Server-only, read by the ERP sync (/erp and `npm run sync:holded`); sent as
# "Authorization: Bearer <key>". Needs the sales:invoices.read permission.
# Leave empty to use only the Excel import (`npm run import:holded`).
HOLDED_API_KEY=

# Informa D&B API v2 ("Buscar en Informa por CIF" in Nuevo scoring). Server-only:
# never exposed with NEXT_PUBLIC_, never stored in the DB. The URL must be https
# on *.informa.es (the credentials are sent there). The session id comes from
#   curl -X POST -H "username: <user>" -H "password: <password>" https://services.informa.es/api/v2/login
# (datosProducto.idSesion) and may expire: renew it when Informa answers code 10001.
# Settings -> Informa -> "Probar conexión" checks it against the demo CIF A00000000.
INFORMA_API_URL=https://services.informa.es/api/v2
INFORMA_USERNAME=
INFORMA_SESSION=
